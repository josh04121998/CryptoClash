# Copy to .env (gitignored) and fill in real values. Never commit .env.
#
# Robinhood Chain testnet (chain ID 46630) public RPC — rate-limited, fine for this
# groundwork phase. Get an Alchemy endpoint instead for anything beyond occasional use:
# https://docs.robinhood.com/chain/connecting
WEB3_RPC_URL=https://rpc.testnet.chain.robinhood.com

# A throwaway deployer/operator wallet's private key — generate one with
# `npm run generate-wallet --workspace=web3`, then fund it via
# https://faucet.testnet.chain.robinhood.com before deploying or minting.
# Testnet-only value. Never reuse a mainnet key here.
WEB3_OPERATOR_PRIVATE_KEY=

# Set after deploying (npm run deploy:testnet --workspace=web3) — the FloorwarsCards
# contract's address on whichever network WEB3_RPC_URL points at.
WEB3_CONTRACT_ADDRESS=

# Must match the chain WEB3_RPC_URL actually points at (used to validate the
# connection, not to select the network — see src/chainConfig.ts).
WEB3_CHAIN_ID=46630
